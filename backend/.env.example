# Backend Environment Variables
# Copy this file to .env and fill in your values.

# Gemini API key — get one at https://aistudio.google.com/app/apikey
# Leave blank to use the deterministic offline fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string (used by SQLAlchemy)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://netsage:netsage@localhost:5432/netsage_db

# Path to the cases CSV file (relative to backend/)
CASES_CSV_PATH=../data/cases.csv
